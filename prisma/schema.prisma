generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Departamento {
  id         Int        @id @default(autoincrement())
  nombre     String     @unique
  usuarios   Usuario[]
  createdAt  DateTime   @default(now())
}

model TipoProfesor {
  id         Int        @id @default(autoincrement())
  nombre     String     @unique
  usuarios   Usuario[]
  createdAt  DateTime   @default(now())
}

model Usuario {
  id             Int      @id @default(autoincrement())
  nombre         String
  email          String   @unique
  password       String
  role           String   @default("alumno") // alumno | profesor | admin
  foto           String?
  createdAt      DateTime @default(now())

  // Alumno-specific
  matricula      String?  @unique

  // Profesor-specific
  departamentoId Int?
  tipoId         Int?
  duracionCita   Int      @default(30)

  departamento      Departamento?    @relation(fields: [departamentoId], references: [id])
  tipo              TipoProfesor?    @relation(fields: [tipoId], references: [id])
  citasComoProfesor Cita[]           @relation("CitaProfesor")
  citasComoAlumno   Cita[]           @relation("CitaAlumno")
  disponibilidades  Disponibilidad[]
  bloqueos          BloqueProfesor[]
  refreshTokens     RefreshToken[]
}

model BloqueProfesor {
  id         Int      @id @default(autoincrement())
  usuario    Usuario  @relation(fields: [profesorId], references: [id])
  profesorId Int
  fecha      DateTime
  motivo     String?
  createdAt  DateTime @default(now())

  @@unique([profesorId, fecha])
}

model Disponibilidad {
  id          Int      @id @default(autoincrement())
  usuario     Usuario  @relation(fields: [profesorId], references: [id])
  profesorId  Int
  diaSemana   Int
  horaInicio  String
  horaFin     String
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  usuario   Usuario  @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

enum EstadoCita {
  agendada
  cancelada
  completada
}

model Cita {
  id         Int        @id @default(autoincrement())

  profesor   Usuario    @relation("CitaProfesor", fields: [profesorId], references: [id])
  profesorId Int

  alumno     Usuario    @relation("CitaAlumno", fields: [alumnoId], references: [id])
  alumnoId   Int

  fecha      DateTime
  horaInicio String
  horaFin    String
  motivo     String
  estado     EstadoCita @default(agendada)
  createdAt  DateTime   @default(now())

  @@index([profesorId, fecha, horaInicio])
}
